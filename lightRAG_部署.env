二、docker部署

    LLM_BINDING=ollama
    LLM_MODEL=qwen3
    LLM_BINDING_HOST=http://host.docker.internal:11434
    #LLM_BINDING_API_KEY=

    #LLM_BINDING=openai
    #LLM_MODEL=gpt-4o-mini
    #LLM_BINDING_HOST="https://apitoken.ceba.ceshiren.com/openai"
    #LLM_BINDING_API_KEY="e941e5e0e10f529cc5757854915b03bd"

    ### OpenAI compatible embedding
    #EMBEDDING_BINDING=openai
    #EMBEDDING_BINDING_HOST="https://apitoken.ceba.ceshiren.com/openai"
    #EMBEDDING_BINDING_API_KEY="e941e5e0e10f529cc5757854915b03bd"
    #EMBEDDING_MODEL=text-embedding-3-small

    EMBEDDING_BINDING=ollama
    EMBEDDING_BINDING_HOST="http://host.docker.internal:11434"
    #EMBEDDING_BINDING_API_KEY=
    #EMBEDDING_MODEL=qwen3-embedding:latest
    EMBEDDING_MODEL=bge-m3:latest

    EMBEDDING_DIM=1024
    EMBEDDING_SEND_DIM=true
    EMBEDDING_TOKEN_LIMIT=8192

    OPENAI_LLM_MAX_COMPLETION_TOKENS=9000

    OLLAMA_LLM_NUM_CTX=32768

